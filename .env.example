# Preferred single connection string
DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/hotel_management

# Fallback split DB settings
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hotel_management
DB_ALLOW_SQLITE_FALLBACK=false

# JWT/app secret
SECRET_KEY=change-this-to-a-long-random-secret
