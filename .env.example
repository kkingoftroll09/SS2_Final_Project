## Backend (required)
DATABASE_URL=postgresql+psycopg2://<user>:<password>@<host>:5432/hotel_management
SECRET_KEY=replace-with-a-long-random-secret

## Backend (optional fallback fields if DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hotel_management
DB_ALLOW_SQLITE_FALLBACK=true

## Backend runtime (optional)
FRONTEND_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
PORT=8000

## Data migration utilities (optional)
SOURCE_DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:3306/<database>

## Frontend deploy setting (optional, used by static host env injection)
API_BASE_URL=http://127.0.0.1:8000
