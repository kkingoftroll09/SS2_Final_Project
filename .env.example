# Example environment variables for SS2 Project

# Backend
DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@127.0.0.1:5432/ss2_db
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ss2_db
DB_ALLOW_SQLITE_FALLBACK=false
SECRET_KEY=change_this_secret

# Frontend (if needed)
# Configure in frontend booking hotel management/config.js if used
API_BASE_URL=http://127.0.0.1:8000

# Optional third-party credentials (placeholders)
# STRIPE_API_KEY=sk_test_xxx
# SENDGRID_API_KEY=SG.xxxx
