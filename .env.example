# Example environment variables for SS2 Project

# Backend
DATABASE_URL=postgresql+psycopg2://DB_CREDENTIALS_AND_HOST/hotel_management
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hotel_management
DB_ALLOW_SQLITE_FALLBACK=false
# Replace with a long random secret value in production.
SECRET_KEY=your-secret-key-here

# Frontend reference (if needed)
# Keep this value aligned with your frontend runtime API configuration.
API_BASE_URL=http://127.0.0.1:8000

# Optional third-party credentials (placeholders)
# STRIPE_API_KEY=sk_test_xxx
# SENDGRID_API_KEY=SG.xxxx
